#!/usr/bin/env bash
# plesk-audit-notify — run the audits and mail out ONLY when something is wrong.
#
# Why this exists: an audit that only runs by hand eventually stops running,
# and a finding can sit unnoticed for weeks even though the check for it exists
# and is correct. A tool nobody invokes is not a fix.
#
# Notification logic, guarding against two failure modes at once:
#   - Mail when the set of findings CHANGES (new or resolved).
#   - Plus a reminder every REMIND_DAYS while anything is still open.
#     Otherwise a daily mail becomes background noise and stops being read.
#   - Clean now and clean before: NO mail.
#
# Usage:  plesk-audit-notify [--dry-run] [--force]
set -uo pipefail

MAILTO="${PTBOX_NOTIFY_MAILTO:-}"
REMIND_DAYS="${PTBOX_NOTIFY_REMIND_DAYS:-7}"
STATE="${PTBOX_NOTIFY_STATE:-/var/lib/plesk-toolbox/audit-notify.state}"
DRY=0; FORCE=0
for a in "$@"; do
    case "$a" in
        --dry-run) DRY=1 ;;
        --force)   FORCE=1 ;;
        *) echo "unknown option: $a" >&2; exit 2 ;;
    esac
done

# Recipient: explicit if set, otherwise Plesk's admin contact.
if [[ -z "$MAILTO" ]]; then
    MAILTO="$(plesk db -Ne "SELECT val FROM misc WHERE param='admin_email';" 2>/dev/null | head -n1)"
fi
[[ -n "$MAILTO" ]] || { echo "no recipient (PTBOX_NOTIFY_MAILTO or Plesk admin_email)" >&2; exit 1; }

HOST="$(hostname -f 2>/dev/null || hostname)"
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT

# Collect both audits.
# The audits exit 1 as soon as there are findings — that is the normal case, not a
# failure. So the exit code is NOT what we judge; we judge whether usable JSON came
# out. An audit that produces no JSON at all is itself a finding.
for kind in sec health; do
    case "$kind" in
        sec)    cmd=(plesk-sec-audit --json) ;;
        health) cmd=(plesk-audit health --json) ;;
    esac
    "${cmd[@]}" > "$tmp/$kind.json" 2>"$tmp/$kind.err" || true
    python3 - "$tmp/$kind.json" "$kind" >> "$tmp/findings.tsv" <<'PY'
import json, sys
path, kind = sys.argv[1], sys.argv[2]
try:
    data = json.load(open(path))
    items = data.get("results", data if isinstance(data, list) else [])
    if not items:
        raise ValueError("no results present")
except Exception as e:
    print(f"AUDIT-ERROR\t{kind}\thigh\t{kind} audit produced no usable result: {e}")
    sys.exit(0)
for it in items:
    st = (it.get("status") or "").lower()
    sev = (it.get("severity") or "").lower()
    # Reported: everything failing, plus high-severity warnings.
    if st == "fail" or (st == "warn" and sev == "high"):
        msg = (it.get("message") or "").strip()
        fix = (it.get("fix") or "").strip()
        print(f"{st.upper()}\t{it.get('id','?')}\t{sev}\t{msg}" + (f"  →  {fix}" if fix else ""))
PY
done
touch "$tmp/findings.tsv"
sort -o "$tmp/findings.tsv" "$tmp/findings.tsv"
count=$(grep -c . "$tmp/findings.tsv" || true)
now=$(date +%s)
fingerprint=$(cut -f1,2 "$tmp/findings.tsv" | sha256sum | cut -d' ' -f1)

prev_fp=""; prev_sent=0
if [[ -r "$STATE" ]]; then
    prev_fp="$(sed -n '1p' "$STATE")"
    prev_sent="$(sed -n '2p' "$STATE")"
    [[ "$prev_sent" =~ ^[0-9]+$ ]] || prev_sent=0
fi

reason=""
if (( FORCE )); then reason="forced"
elif [[ "$fingerprint" != "$prev_fp" ]]; then
    if (( count > 0 )); then reason="findings changed"
    elif [[ -n "$prev_fp" ]]; then reason="all findings resolved"; fi
elif (( count > 0 )) && (( now - prev_sent >= REMIND_DAYS * 86400 )); then
    reason="reminder — unchanged and open for ${REMIND_DAYS} days"
fi

if [[ -z "$reason" ]]; then
    echo "no notification needed (${count} finding(s), unchanged)"
    exit 0
fi

subject="[${HOST}] Audit: ${count} finding(s) — ${reason}"
(( count == 0 )) && subject="[${HOST}] Audit: all clear — ${reason}"

{
    echo "Server:   $HOST"
    echo "Time:     $(date '+%Y-%m-%d %H:%M:%S %Z')"
    echo "Trigger:  $reason"
    echo "Findings: $count"
    echo
    if (( count > 0 )); then
        echo "── What is wrong ──"
        while IFS=$'\t' read -r st id sev msg; do
            [[ -n "$id" ]] || continue
            printf '  [%-4s %-6s] %s\n           %s\n\n' "$st" "$sev" "$id" "$msg"
        done < "$tmp/findings.tsv"
    else
        echo "Every checked item is in order."
    fi
    echo "── Where to look ──"
    echo "  plesk-sec-audit        (security: DANE/TLSA, TLS, headers)"
    echo "  plesk-audit health     (services, disk, memory, mail hygiene)"
} > "$tmp/body.txt"

if (( DRY )); then
    echo "── DRY RUN, would send to $MAILTO ──"
    echo "Subject: $subject"
    cat "$tmp/body.txt"
    exit 0
fi

if command -v sendmail >/dev/null 2>&1; then
    { printf 'To: %s\nSubject: %s\nContent-Type: text/plain; charset=UTF-8\n\n' "$MAILTO" "$subject"
      cat "$tmp/body.txt"; } | sendmail -t
else
    mail -s "$subject" "$MAILTO" < "$tmp/body.txt"
fi

mkdir -p "$(dirname "$STATE")"
printf '%s\n%s\n' "$fingerprint" "$now" > "$STATE"
echo "notified $MAILTO ($count findings, $reason)"
