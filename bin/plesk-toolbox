#!/usr/bin/env bash
# plesk-toolbox - subcommand dispatcher entrypoint
#
# Deliberately no `set -e` / `pipefail`: this script sources arbitrary audit
# files from audits.d/, and patterns like `awk '... exit'` trigger SIGPIPE on
# upstream commands. Audit files report results via emit() and do not rely on
# exit codes — making the dispatcher itself errexit-aware would mean every
# transient failure in a check kills the whole run silently.
set -u

PTBOX_ROOT="${PTBOX_ROOT:-/opt/plesk-toolbox}"
export PTBOX_ROOT

# Dev-mode: when running from source tree (not installed), use that root
if [[ ! -d "${PTBOX_ROOT}/lib" ]]; then
    _self="$(readlink -f "${BASH_SOURCE[0]}")"
    PTBOX_ROOT="$(cd "$(dirname "$_self")/.." && pwd)"
    export PTBOX_ROOT
fi

# shellcheck source=../lib/dispatch.sh
. "${PTBOX_ROOT}/lib/dispatch.sh"

dispatch_main "$@"
