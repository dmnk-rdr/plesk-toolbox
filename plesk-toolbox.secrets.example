# /etc/plesk-toolbox.secrets — API credentials (keep out of git!)
#
#   install -m 0600 plesk-toolbox.secrets.example /etc/plesk-toolbox.secrets
#   then fill in real values.
#
# AutoDNS / SchlundTech (InterNetX Domain Robot JSON API) — used by
# `plesk-toolbox tool dns/ensure-mail`. Both brands share the endpoint;
# only the context differs: 4 = AutoDNS, 10 = SchlundTech.
AUTODNS_USER=""
AUTODNS_PASSWORD=""
AUTODNS_CONTEXT=10
